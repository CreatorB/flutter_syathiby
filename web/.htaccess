# ==========================================================
# SECURITY HEADERS (Geolocation + Mixed Content Fix)
# ==========================================================
<IfModule mod_headers.c>
  # Izinkan akses geolocation untuk Safari iOS
  Header always set Permissions-Policy "geolocation=(*), camera=(*), microphone=(*)"
  # Paksa upgrade HTTP ke HTTPS untuk semua resource (fix mixed content)
  Header always set Content-Security-Policy "upgrade-insecure-requests"
  
  # CRITICAL: Prevent caching for index.html and version.json
  # This ensures users always get latest version after deployment
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ==========================================================
# PAKSA HTTPS
# ==========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect HTTP ke HTTPS
  # FIX 2026-09-01: cek X-Forwarded-Proto (header dari nginx proxy), BUKAN %{HTTPS}
  # Karena di belakang nginx proxy %{HTTPS} selalu "off" → redirect loop
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Flutter web SPA routing - arahkan semua ke index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ==========================================================
# MIME Types
# ==========================================================
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/json .map
  AddType application/javascript .js
</IfModule>

# ==========================================================
# Caching untuk performa (static assets only)
# ==========================================================
<IfModule mod_expires.c>
  ExpiresActive On
  # Long cache for static assets (they have hash in filename)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  
  # NO CACHE for HTML and JSON (always fresh for updates)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ==========================================================
# VERSION CHECK ENDPOINT
# ==========================================================
# Allow version.json to be accessed without caching
<Files "version.json">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Access-Control-Allow-Origin "*"
</Files>

# ==========================================================
# JANGAN CACHE entry point Flutter web
# ==========================================================
# main.dart.js, flutter_service_worker.js, flutter_bootstrap.js, dan flutter.js
# TIDAK punya hash di nama file (beda dengan aset di assets/ dan canvaskit/),
# jadi aturan "1 year" di atas membuat browser menyimpannya sampai 10 tahun dan
# pengguna terkunci di build LAMA selamanya.
#
# Yang paling fatal flutter_service_worker.js: kalau dia basi, dia terus
# menyajikan main.dart.js lama dari cache walau server sudah punya yang baru.
# Ini yang membuat Flutter web tetap menampilkan v1.0.8 setelah deploy v1.0.9.
<IfModule mod_headers.c>
  <FilesMatch "^(main\.dart\.js|flutter_service_worker\.js|flutter_bootstrap\.js|flutter\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
